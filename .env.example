# Provider configuration (server-side only; no provider is hard-coded)
# Supported presets: demo, openai, openrouter, ollama, lmstudio, openai-compatible
# demo runs without credentials for UI/API smoke testing; it is not a real translator
LLM_PROVIDER=openrouter

# Model. OpenRouter free-tier examples:
#   openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash:free
LLM_MODEL=openai/gpt-4o-mini

# Required for hosted providers. Generate a free key at https://openrouter.ai/settings/keys
LLM_API_KEY=

# Required for openai-compatible; presets provide defaults for the others
# LLM_BASE_URL=https://openrouter.ai/api/v1
# PORT=3000
